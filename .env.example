# Optional Gemini synthesis. Leave blank for the built-in catalogue-only assistant.
# Never commit your actual API key or expose it in VITE_ frontend variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional comma-separated HTTPS frontend origin(s) for a future deployment.
# Example: https://your-frontend.example (do not include / at the end)
FLAREX_CORS_ORIGINS=
