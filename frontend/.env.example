# The frontend normally uses Vite's /api proxy or production same-origin API.
# Set this ONLY if the API is hosted separately; it becomes public browser code.
# VITE_API_BASE_URL=https://your-api.example

# Optional development-only proxy target (server config, not exposed to browser).
# FLAREX_DEV_API_TARGET=http://127.0.0.1:8000

# Never put GEMINI_API_KEY or any credentials in this frontend env file.
