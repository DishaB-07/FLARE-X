{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flare-x.local/schema/investigations.schema.json",
  "title": "FLARE-X Investigation Catalogue",
  "type": "object",
  "required": ["dataset_name", "schema_version", "record_count", "source", "records"],
  "properties": {
    "dataset_name": {"type": "string"},
    "schema_version": {"type": "string"},
    "record_count": {"type": "integer", "minimum": 0},
    "source": {"type": "object"},
    "attribution": {"type": "string"},
    "si_disclosure": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "research_area", "type", "objective", "approach", "fuel_material", "numeric_conditions", "doi", "data_availability", "source_url"],
        "properties": {
          "id": {"type": "string", "pattern": "^PSI-[0-9]+$"},
          "title": {"type": "string"},
          "research_area": {"type": "string"},
          "type": {"enum": ["Ground Investigation", "Microgravity Investigation", "Reduced Gravity Investigation"]},
          "objective": {"type": "object", "required": ["text", "completeness"], "properties": {"text": {"type": "string"}, "completeness": {"type": "string"}}},
          "approach": {"type": "object", "required": ["text", "completeness"], "properties": {"text": {"type": "string"}, "completeness": {"type": "string"}}},
          "fuel_material": {"type": "array", "items": {"type": "string"}},
          "numeric_conditions": {"type": "object"},
          "related_investigation_ids": {"type": "array", "items": {"type": "string"}},
          "doi": {"type": ["string", "null"]},
          "data_availability": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
